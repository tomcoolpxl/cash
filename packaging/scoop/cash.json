{
    "version": "1.1.0",
    "description": "Cool Again Shell: a Bash-language shell for Windows, with its Unix tools built in",
    "homepage": "https://github.com/tomcoolpxl/cash",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/tomcoolpxl/cash/blob/main/LICENSE"
    },
    "notes": [
        "If Scoop listed a running cash above, that is this window: it keeps the old version until you close it. New tabs start the new one.",
        "Windows Terminal has a \"cash\" profile, and the Start menu a cash entry. cash doctor checks the install.",
        "To add \"Open cash here\" to Explorer's menu of a directory: cash --explorer-menu",
        "To open .sh scripts with cash: cash --associate-sh"
    ],
    "suggest": {
        "carapace": "extras/carapace-bin",
        "Nerd Font": "nerd-fonts/CascadiaMono-NF"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/tomcoolpxl/cash/releases/download/v1.1.0/cash-v1.1.0-x86_64-pc-windows-msvc.zip",
            "hash": "c23cd552600052ab0e8e0d0a3088f8b6c871004944140e6b448a3d10dc62274b"
        }
    },
    "bin": "cash.exe",
    "persist": "bin",
    "post_install": [
        "$cash = \"$(Split-Path $dir)\\current\\cash.exe\"",
        "& $cash --terminal-profile *> $null",
        "if (Test-Path \"$persist_dir\\bin\\.cash-links\") { & $cash --link-tools *> $null }",
        "& $cash --init-rc --once *> $null",
        "$lnk = \"$([Environment]::GetFolderPath('StartMenu'))\\Programs\\Scoop Apps\\cash.lnk\"",
        "$wt = \"$env:LOCALAPPDATA\\Microsoft\\WindowsApps\\wt.exe\"",
        "New-Item -ItemType Directory -Force (Split-Path $lnk) | Out-Null",
        "$link = (New-Object -ComObject WScript.Shell).CreateShortcut($lnk)",
        "if (Test-Path $wt) { $link.TargetPath = $wt; $link.Arguments = '-p cash' } else { $link.TargetPath = $cash; $link.WorkingDirectory = $env:USERPROFILE }",
        "$link.IconLocation = \"$cash,0\"",
        "$link.Save()"
    ],
    "pre_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    if (Test-Path \"$persist_dir\\bin\\.cash-links\") { & \"$dir\\cash.exe\" --unlink-tools *> $null }",
        "    & \"$dir\\cash.exe\" --remove-terminal-profile *> $null",
        "    & \"$dir\\cash.exe\" --remove-explorer-menu *> $null",
        "    & \"$dir\\cash.exe\" --remove-sh-association *> $null",
        "    Remove-Item -LiteralPath \"$([Environment]::GetFolderPath('StartMenu'))\\Programs\\Scoop Apps\\cash.lnk\" -ErrorAction SilentlyContinue",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tomcoolpxl/cash/releases/download/v$version/cash-v$version-x86_64-pc-windows-msvc.zip",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
