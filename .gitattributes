# cash's own sources are LF, always, regardless of the user's core.autocrlf.
# This is the practice D20 recommends to everyone else.
* text=auto eol=lf

*.rs    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Windows script formats genuinely want CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Test fixtures whose line endings ARE the test (D20, D41). Never normalise.
tests/fixtures/crlf/** -text
tests/fixtures/bom/**  -text
*.crlf  -text
*.bom   -text

# Binaries
# A sixel picture is ASCII, but one line of escape sequences that no diff can show.
*.six binary
*.exe binary
*.dll binary
*.pdb binary
