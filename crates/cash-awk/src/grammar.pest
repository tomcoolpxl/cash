WHITESPACE = _{ " " | "\t" | "\r" | "\\" ~ "\n" }
COMMENT    = _{ "#" ~ (!"\n" ~ ANY)* ~ (&"\n" | &EOI) }

string          = ${ "\"" ~ string_contents ~ "\"" }
string_contents = @{ string_char* }
// Any character may follow a backslash: one awk does not define stands for itself, as gawk
// has it (`split(s, parts, "\.")`); see `escape_string_contents`.
// A newline ends a string, which is then unterminated, as in gawk; a backslash before one
// continues the string on the next line.
string_char     =  {
    !("\"" | "\\" | "\n") ~ ANY
  | "\\" ~ ASCII_DIGIT{1, 3}
  | "\\" ~ ANY
}
// A `/` in a bracket expression does not end the regex, as gawk's lexer reads one
// (`/[/]/`); nor is a `#` in it a comment, nor white space skipped. A backslash before a
// newline joins the lines, as in a string.
ere             = ${ "/" ~ (ere_bracket | ("\\" ~ ANY) | (!("/" | "\n" | "[") ~ ANY))* ~ "/" }
ere_class       = _{
    "[:" ~ (!(":]" | "\n") ~ ANY)* ~ ":]"
  | "[." ~ (!(".]" | "\n") ~ ANY)* ~ ".]"
  | "[=" ~ (!("=]" | "\n") ~ ANY)* ~ "=]"
}
ere_bracket     = _{
    "[" ~ "^"? ~ "]"? ~ (
        ere_class
      | ("\\" ~ ANY)
      | (!("]" | "\n") ~ ANY)
    )* ~ "]"
}
number          = @{ decimal_float | integer }
digit           =  { ('0'..'9') }
integer         = @{ digit+ }
decimal_float   =  { (fractional_part ~ exponent? ~ float_suffix?) | (integer ~ exponent ~ float_suffix?) }
fractional_part =  { (integer? ~ "." ~ integer) | integer ~ "." }
exponent        =  { ("e" | "E") ~ sign? ~ integer }
sign            =  { "+" | "-" }
float_suffix    =  { "f" | "l" | "F" | "L" }

letter    =  { ('a'..'z') | ('A'..'Z') }
name      = @{ !(keyword | builtin_func | special_pattern) ~ (letter | "_") ~ (letter | "_" | digit)* }

// `BEGIN` and `END` are reserved, as in gawk: not variables, so `END END END` is a
// syntax error rather than a pattern.
special_pattern = _{ ("BEGIN" | "END") ~ !(letter | "_" | digit) }

func_name = @{ name ~ &"(" }

builtin_func = _{
    atan2
  | cos
  | sin
  | exp
  | log
  | sqrt
  | int
  | rand
  | srand
  | gsub
  | index
  | length
  | match_fn
  | split
  | sprintf
  | substr
  | sub
  | tolower
  | toupper
  | close
  | fflush
  | system
  | isarray
  | asorti
  | asort
  | gensub
}

atan2    = { "atan2" ~ !(letter | "_" | digit) }
cos      = { "cos" ~ !(letter | "_" | digit) }
sin      = { "sin" ~ !(letter | "_" | digit) }
exp      = { "exp" ~ !(letter | "_" | digit) }
log      = { "log" ~ !(letter | "_" | digit) }
sqrt     = { "sqrt" ~ !(letter | "_" | digit) }
int      = { "int" ~ !(letter | "_" | digit) }
rand     = { "rand" ~ !(letter | "_" | digit) }
srand    = { "srand" ~ !(letter | "_" | digit) }
gsub     = { "gsub" ~ !(letter | "_" | digit) }
index    = { "index" ~ !(letter | "_" | digit) }
length   = { "length" ~ !(letter | "_" | digit) }
match_fn = { "match" ~ !(letter | "_" | digit) }
split    = { "split" ~ !(letter | "_" | digit) }
sprintf  = { "sprintf" ~ !(letter | "_" | digit) }
sub      = { "sub" ~ !(letter | "_" | digit) }
substr   = { "substr" ~ !(letter | "_" | digit) }
tolower  = { "tolower" ~ !(letter | "_" | digit) }
toupper  = { "toupper" ~ !(letter | "_" | digit) }
close    = { "close" ~ !(letter | "_" | digit) }
fflush   = { "fflush" ~ !(letter | "_" | digit) }
system   = { "system" ~ !(letter | "_" | digit) }
isarray  = { "isarray" ~ !(letter | "_" | digit) }
asort    = { "asort" ~ !(letter | "_" | digit) }
asorti   = { "asorti" ~ !(letter | "_" | digit) }
gensub   = { "gensub" ~ !(letter | "_" | digit) }

// gawk's reserved words that cash knows. `begin`, `end` and `foreach` are plain names, as
// in gawk. A choice does not back off to a later word when the end of a name fails to
// follow, so a word comes before any shorter word it starts with (`nextfile`, `next`).
keyword = {
    ("function"
  | "continue"
  | "nextfile"
  | "getline"
  | "delete"
  | "printf"
  | "return"
  | "while"
  | "break"
  | "else"
  | "exit"
  | "next"
  | "func"
  | "print"
  | "for"
  | "if"
  | "do"
  | "in") ~ !(letter | "_" | digit)
}

program = { SOI ~ opt_newline ~ (item ~ terminator)* ~ item? ~ opt_newline ~ EOI }

terminator = _{ ";"? ~ "\n"* }

opt_newline = _{ "\n"* }

item = _{
    begin_action
  | end_action
  | rule
  | function_definition
}

begin_action = { begin_word ~ action }
end_action   = { end_word ~ action }

rule = {
    action
  | pattern_and_action
  | normal_pattern
}

pattern_and_action = {
    normal_pattern ~ action
}

// `func` is gawk's other spelling of `function`.
function_definition = { (function_word | func_word) ~ name ~ "(" ~ param_list? ~ ")" ~ opt_newline ~ action }

// A newline may follow a comma, as in gawk.
param_list = { name ~ ("," ~ opt_newline ~ name)* }

normal_pattern = { range_pattern | expr }
range_pattern  = { expr ~ "," ~ opt_newline ~ expr }

action = {
    "{" ~ opt_newline ~ "}"
  | "{" ~ opt_newline ~ terminated_statement* ~ unterminated_statement? ~ "}"
}

terminated_statement = _{
    action ~ opt_newline
  | t_if
  | t_while
  | t_for
  | t_foreach
  | empty_stmt
  | terminatable_statement ~ "\n" ~ opt_newline
  | terminatable_statement ~ ";" ~ opt_newline
}

t_if       =  { if_word ~ "(" ~ expr ~ ")" ~ opt_newline ~ terminated_statement ~ (!else_word | else_word ~ opt_newline ~ terminated_statement) }
t_while    =  { while_word ~ "(" ~ expr ~ ")" ~ opt_newline ~ terminated_statement }
t_for      =  { for_word ~ "(" ~ for_init ~ ";" ~ for_condition ~ ";" ~ for_update ~ ")" ~ opt_newline ~ terminated_statement }
// Each clause of `for (init; condition; update)` may be empty. Wrapping them keeps
// the three always present as pairs, so the compiler can tell which one is missing.
for_init      = { simple_statement? }
for_condition = { expr? }
for_update    = { simple_statement? }
t_foreach  =  { for_word ~ "(" ~ name ~ in_op ~ array_ref ~ ")" ~ opt_newline ~ terminated_statement }
// A node of its own, so that an empty body keeps its place: in `if (c); else s` the
// `else` branch is not the `if`'s body.
empty_stmt =  { ";" ~ opt_newline }

unterminated_statement = _{
    terminatable_statement
  | ut_if
  | ut_while
  | ut_for
  | ut_foreach
}

ut_if      = { if_word ~ "(" ~ expr ~ ")" ~ opt_newline ~ (terminated_statement ~ else_word ~ opt_newline ~ unterminated_statement | unterminated_statement) }
ut_while   = { while_word ~ "(" ~ expr ~ ")" ~ opt_newline ~ unterminated_statement }
ut_for     = { for_word ~ "(" ~ for_init ~ ";" ~ for_condition ~ ";" ~ for_update ~ ")" ~ opt_newline ~ unterminated_statement }
ut_foreach = { for_word ~ "(" ~ name ~ in_op ~ array_ref ~ ")" ~ opt_newline ~ unterminated_statement }

terminatable_statement = _{
    nextfile
  | next
  | break_stmt
  | continue_stmt
  | exit_stmt
  | return_stmt
  | do_while
  | simple_statement
}

do_while      = { do_word ~ opt_newline ~ terminated_statement ~ while_word ~ "(" ~ expr ~ ")" }
next          = { next_word }
nextfile      = { nextfile_word }
break_stmt    = { break_word }
continue_stmt = { continue_word }

return_stmt = { return_word ~ expr? }
exit_stmt   = { exit_word ~ expr? }

simple_statement = {
    array_delete
  | print_stmt
  | expr
}

array_delete = {
    delete_word ~ name ~ subscript*
}

print_stmt = {
    (printf_call | simple_printf | print_call | simple_print) ~ output_redirection?
}

simple_print       =  { print_word ~ print_expr_list? }
print_call         =  { print_word ~ "(" ~ multiple_expr_list ~ ")" ~ !in_op }
// gawk takes `printf` with nothing to print, and fails when it runs it.
simple_printf      =  { printf_word ~ print_expr_list? }
printf_call        =  { printf_word ~ "(" ~ multiple_expr_list ~ ")" ~ !in_op }
output_redirection = _{
    truncate
  | append
  | pipe
}

// The target of a redirection is gawk's common expression, without a comparison: `print >
// "x" > "y"` is a syntax error, as in gawk; it was the file `"x" > "y"`.
truncate = { ">" ~ simple_getline_file_expr }
append   = { ">>" ~ simple_getline_file_expr }
pipe     = { "|" ~ simple_getline_file_expr }

print_expr_list    = _{ print_expr ~ ("," ~ opt_newline ~ print_expr)* }
expr_list          = _{ multiple_expr_list | expr }
multiple_expr_list = _{ expr ~ ("," ~ opt_newline ~ expr)+ }

primary = _{
    "(" ~ expr ~ ")"
  | ere
  | number
  | string
  | builtin_function_call
  | function_call
  | simple_getline
  | lvalue
}

// gawk's arrays of arrays: `a[1][2]` is the element 2 of the subarray `a[1]`.
array_element         = { name ~ subscript+ }
subscript             = { "[" ~ expr_list ~ "]" }
// An array, a variable's or a subarray, where only an array can be: `for (k in a[1])`.
array_ref             = { name ~ subscript* }
function_call         = { func_name ~ "(" ~ expr_list? ~ ")" }
builtin_function_call = { builtin_func ~ ("(" ~ expr_list? ~ ")")? }

prefix_op = _{
    pre_inc
  | pre_dec
  | not
  | unary_plus
  | negate
}

pre_inc    = { "++" }
pre_dec    = { "--" }
not        = { "!" }
unary_plus = { "+" }
negate     = { "-" }

postfix_op = _{
    post_inc
  | post_dec
}

post_inc = { "++" }
post_dec = { "--" }

// gawk's grammar has an expression, which may be an assignment, after a comparison, a
// match, `&&` and `||`, and a simpler operand after the others: `a || b = 1` is `a || (b =
// 1)`, and `1 + x /=2/` is `1 + x` joined to the regex `/=2/`.
low_infix_op = _{
    comp_op
  | match_op
  | not_match
  | and
  | or
}
high_infix_op = _{
    pow
  | mul
  | div
  | modulus
  | add
  | binary_sub
  | in_op
  | concat
}

// `**` is gawk's other spelling of `^`.
pow        = { "^" | "**" }
mul        = { "*" }
// `/=` divides nowhere in gawk: after a variable it is an assignment, elsewhere the start
// of a regex.
div        = { "/" ~ !"=" }
modulus    = { "%" }
add        = { "+" }
binary_sub = { "-" }
match_op   = { "~" }
not_match  = { "!~" }
and        = { "&&" }
or         = { "||" }
concat     = { "" }
in_op      = @{ "in" ~ !(letter | "_" | digit) }

comp_op = {
    le
  | lt
  | ge
  | gt
  | ne
  | eq
}

lt = { "<" }
le = { "<=" }
ne = { "!=" }
eq = { "==" }
gt = { ">" }
ge = { ">=" }

binary_expr = {
    multidimensional_in
  | simple_binary_expr
}

multidimensional_in    = { "(" ~ multidimensional_index ~ ")" ~ in_word ~ array_ref }
// Prefix operators may follow one another, as `- -x` and `!-x` in gawk.
simple_binary_expr     = { expr_operand ~ (low_infix_op ~ low_operand | high_infix_op ~ operand)* }
operand                = _{ prefix_op* ~ primary ~ postfix_op? }
// An operand that starts an expression: a variable followed by `/=` is the target of an
// assignment, so `/=` cannot start a regex after it, as in gawk (`x /=2/` is an error).
expr_operand           = _{ !(lvalue ~ "/=") ~ operand }
low_operand            = _{ assigned | expr_operand }
assigned               =  { assignment }
multidimensional_index = { multiple_expr_list }

ternary_expr = { binary_expr ~ "?" ~ expr ~ ":" ~ expr }

assignment = { lvalue ~ assignment_op ~ expr }

assignment_op = {
    assign
  | add_assign
  | sub_assign
  | mul_assign
  | div_assign
  | mod_assign
  | pow_assign
}

assign     = { "=" }
add_assign = { "+=" }
sub_assign = { "-=" }
mul_assign = { "*=" }
div_assign = { "/=" }
mod_assign = { "%=" }
pow_assign = { "^=" | "**=" }

expr = {
    input_function
  | assignment
  | ternary_expr
  | binary_expr
}

lvalue = {
    array_element
  | name
  | field_var
}

field_var = { "$" ~ prefix_op* ~ primary ~ postfix_op* }

// A plain `getline` is a primary, as in gawk, so that `getline x y` is `getline x`
// joined to `y`; it was a syntax error.
input_function = {
    getline_from_pipe
  | getline_from_file_cmp
  | getline_from_file
}

getline_from_file_cmp = { getline_word ~ lvalue? ~ "<" ~ simple_getline_file_expr ~ comp_op ~ expr }

simple_getline    = { getline_word ~ lvalue? }
getline_from_file = { getline_word ~ lvalue? ~ "<" ~ simple_getline_file_expr }

simple_getline_file_expr = { prefix_op* ~ primary ~ postfix_op? ~ (getline_infix_op ~ prefix_op* ~ primary ~ postfix_op?)* }
getline_from_pipe = { unpiped_expr ~ (piped_getline)+ }
piped_getline     = { "|" ~ getline_word ~ lvalue? }

unpiped_expr           = {
    unpiped_input_function
  | assignment
  | ternary_expr
  | binary_expr
}
unpiped_input_function = {
    getline_from_file
  | simple_getline
}

// The file of `getline <`, where a comparison ends it, as in every awk.
getline_infix_op         = _{
    pow
  | mul
  | div
  | modulus
  | add
  | binary_sub
  | match_op
  | not_match
  | in_op
  | and
  | or
  | concat
}
// In `print`, a `>` that is not in parentheses is a redirection; the other comparisons
// are comparisons, as in gawk (`print a == b`), which rejected them.
print_low_infix_op       = _{
    print_comp_op
  | match_op
  | not_match
  | and
  | or
}
print_comp_op            =  {
    le
  | lt
  | ge
  | ne
  | eq
}
simple_binary_print_expr =  {
    expr_operand ~ (print_low_infix_op ~ print_low_operand | high_infix_op ~ operand)*
}
print_low_operand        = _{ print_assigned | expr_operand }
print_assigned           =  { print_assignment }
binary_print_expr        =  {
    multidimensional_in
  | simple_binary_print_expr
}

print_assignment   = { lvalue ~ assignment_op ~ print_expr }
ternary_print_expr = { binary_print_expr ~ "?" ~ print_expr ~ ":" ~ print_expr }

print_expr = {
    print_assignment
  | ternary_print_expr
  | binary_print_expr
}

// A keyword only when no name character follows it, as in gawk: `printx = 1`, `deletex` and
// `getlinex` were the keyword and a name. The word is matched under a lookahead that is
// atomic, so that no white space comes between the word and its end.
begin_word = _{ &begin_end ~ "BEGIN" }
begin_end  = @{ "BEGIN" ~ !(letter | "_" | digit) }
end_word = _{ &end_end ~ "END" }
end_end  = @{ "END" ~ !(letter | "_" | digit) }
function_word = _{ &function_end ~ "function" }
function_end  = @{ "function" ~ !(letter | "_" | digit) }
func_word = _{ &func_end ~ "func" }
func_end  = @{ "func" ~ !(letter | "_" | digit) }
if_word = _{ &if_end ~ "if" }
if_end  = @{ "if" ~ !(letter | "_" | digit) }
else_word = _{ &else_end ~ "else" }
else_end  = @{ "else" ~ !(letter | "_" | digit) }
while_word = _{ &while_end ~ "while" }
while_end  = @{ "while" ~ !(letter | "_" | digit) }
for_word = _{ &for_end ~ "for" }
for_end  = @{ "for" ~ !(letter | "_" | digit) }
do_word = _{ &do_end ~ "do" }
do_end  = @{ "do" ~ !(letter | "_" | digit) }
nextfile_word = _{ &nextfile_end ~ "nextfile" }
nextfile_end  = @{ "nextfile" ~ !(letter | "_" | digit) }
next_word = _{ &next_end ~ "next" }
next_end  = @{ "next" ~ !(letter | "_" | digit) }
break_word = _{ &break_end ~ "break" }
break_end  = @{ "break" ~ !(letter | "_" | digit) }
continue_word = _{ &continue_end ~ "continue" }
continue_end  = @{ "continue" ~ !(letter | "_" | digit) }
return_word = _{ &return_end ~ "return" }
return_end  = @{ "return" ~ !(letter | "_" | digit) }
exit_word = _{ &exit_end ~ "exit" }
exit_end  = @{ "exit" ~ !(letter | "_" | digit) }
delete_word = _{ &delete_end ~ "delete" }
delete_end  = @{ "delete" ~ !(letter | "_" | digit) }
printf_word = _{ &printf_end ~ "printf" }
printf_end  = @{ "printf" ~ !(letter | "_" | digit) }
print_word = _{ &print_end ~ "print" }
print_end  = @{ "print" ~ !(letter | "_" | digit) }
getline_word = _{ &getline_end ~ "getline" }
getline_end  = @{ "getline" ~ !(letter | "_" | digit) }
in_word = _{ &in_end ~ "in" }
in_end  = @{ "in" ~ !(letter | "_" | digit) }
